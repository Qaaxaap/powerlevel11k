.cache/

# ── Rust (Cargo) ──
# Compiled files and executables
/target
debug/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC debug info
*.pdb

# PGO / profiling artifacts
*.profraw
*.profdata

# Cargo.lock is intentionally NOT ignored: p11k ships binaries, not a library crate.

# ── zsh ──
# Compiled wordcode
*.zwc

# ── Python (tools/demo) ──
__pycache__/
*.pyc

# ── Editors ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Nix ──
/result
/result-*

# Local run output from background commands; `typos` walks the tree and would report the
# timestamps and log tags in it.
/nohup.out

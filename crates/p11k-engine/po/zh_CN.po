#: crates/p11k-engine/src/cli.rs:173 crates/p11k-engine/src/cli.rs:194
msgid "cannot read config, falling back to the built-in lean theme: "
msgstr "读取配置失败，回退内置 lean 主题: "

#: crates/p11k-engine/src/cli.rs:184
msgid ""
"unknown preset, falling back to the built-in lean theme (expected lean/"
"classic/rainbow/pure): "
msgstr "未知预设，回退内置 lean 主题（可选 lean/classic/rainbow/pure）: "


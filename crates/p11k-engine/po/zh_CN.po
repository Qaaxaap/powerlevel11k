msgid "invalid P11K_ENGINE_PID (must be a positive process id)"
msgstr "无效的 P11K_ENGINE_PID（必须是正的进程号）"

#: crates/p11k-engine/src/cli.rs:233 crates/p11k-engine/src/cli.rs:243
msgid ""
"not inside a p11k session (session data is missing; restart the session)"
msgstr "不在 p11k 会话中（会话数据缺失，请尝试重启会话）"

#: crates/p11k-engine/src/cli.rs:276
msgid "cannot write the reload request:"
msgstr "无法写入 reload 请求："


#: crates/p11k-engine/src/cli.rs:173 crates/p11k-engine/src/cli.rs:194
msgid "cannot read config, falling back to the built-in lean theme: "
msgstr "读取配置失败，回退内置 lean 主题: "

#: crates/p11k-engine/src/cli.rs:184
msgid ""
"unknown preset, falling back to the built-in lean theme (expected lean/"
"classic/rainbow/pure): "
msgstr "未知预设，回退内置 lean 主题（可选 lean/classic/rainbow/pure）: "

#: crates/p11k-engine/src/cli.rs:216
msgid "not inside a p11k session (P11K_ENGINE_PID is unset)"
msgstr "当前不在 p11k 会话中（P11K_ENGINE_PID 未设置）"

#: crates/p11k-engine/src/cli.rs:223
msgid "invalid P11K_ENGINE_PID (must be a positive process id)"
msgstr "无效的 P11K_ENGINE_PID（必须是正的进程号）"

#: crates/p11k-engine/src/cli.rs:233 crates/p11k-engine/src/cli.rs:243
msgid ""
"not inside a p11k session (session data is missing; restart the session)"
msgstr "不在 p11k 会话中（会话数据缺失，请尝试重启会话）"

#: crates/p11k-engine/src/cli.rs:276
msgid "cannot write the reload request:"
msgstr "无法写入 reload 请求："

#: crates/p11k-engine/src/cli.rs:287
msgid "cannot remove the reload request:"
msgstr "无法删除 reload 请求："

#: crates/p11k-engine/src/cli.rs:292
msgid "cannot signal the engine (the session may have exited)"
msgstr "无法向引擎发送信号（会话可能已退出）"

#: crates/p11k-engine/src/cli.rs:303
msgid "cannot read the session file:"
msgstr "无法读取会话文件："

#: crates/p11k-engine/src/cli.rs:306
msgid "the session token does not match; the pid may belong to another process"
msgstr "会话令牌不匹配，该 pid 可能属于另一个进程"

#: crates/p11k-engine/src/cli.rs:330
msgid ""
"this session has no theme file: it was started with --preset or the built-in "
"theme"
msgstr "本会话没有主题文件：启动时用的是 --preset 或内置主题"

#: crates/p11k-engine/src/cli.rs:350
msgid ""
"unknown shell in the config, falling back to $SHELL (expected zsh/bash/fish/"
"pwsh): "
msgstr "配置里的 shell 无法识别，回退到 $SHELL（可选 zsh/bash/fish/pwsh）: "

#: crates/p11k-engine/src/config.rs:75
msgid "invalid colour; a hex colour needs six digits: "
msgstr "十六进制颜色需要六位数字："

#: crates/p11k-engine/src/config.rs:86
msgid "unknown colour name: "
msgstr "未知颜色名："

#: crates/p11k-engine/src/config.rs:87
msgid "use a name, 0-255, #rrggbb or default"
msgstr "请使用颜色名、0-255、#rrggbb 或 default"

#: crates/p11k-engine/src/config.rs:97
msgid "colour index is outside 0-255: "
msgstr "颜色索引超出 0-255："

#: crates/p11k-engine/src/config.rs:100
msgid "expected a colour (0-255, #rrggbb, a colour name or default)"
msgstr "应为颜色（0-255、#rrggbb、颜色名或 default）"

# ---- 配置解析 ----
#: crates/p11k-engine/src/config.rs:528
msgid "KDL parse error: "
msgstr "KDL 解析失败: "

#: crates/p11k-engine/src/config.rs:1316
msgid "`state` needs a name (a positional string)"
msgstr "`state` 需要一个名字（位置字符串）"

#: crates/p11k-engine/src/config.rs:1334
msgid " needs text (a positional string)"
msgstr " 需要文本（位置字符串）"

#: crates/p11k-engine/src/config.rs:1392
msgid "unknown config key: "
msgstr "无法识别的配置键: "

#: crates/p11k-engine/src/engine.rs:213
msgid "the inner shell failed to start"
msgstr "内部 shell 启动失败"

# ---- 引擎本体 ----
#: crates/p11k-engine/src/main.rs:90
msgid "recursive launch detected (p11k started inside a p11k session)"
msgstr "检测到递归启动（在 p11k 会话内再次启动 p11k）"

#: crates/p11k-engine/src/main.rs:91
msgid "make sure the bootstrap line in ~/.zshrc is guarded, e.g.:"
msgstr "请确认 ~/.zshrc 中的引导行包含递归判断，例如："

#: crates/p11k-engine/src/main.rs:95
msgid "cannot exec zsh -f: "
msgstr "exec zsh -f 失败: "


# ---- wizard：预览 / 落盘 ----
msgid "Preview (current directory + exit code):"
msgstr "预览（当前目录 + 退出码）:"

msgid "p11k config file already exists. Overwrite"
msgstr "p11k 配置文件已存在，覆盖"

msgid "New config:"
msgstr "新配置:"

msgid "Add the engine to your shell rc (pick yours):"
msgstr "安装到 shell rc（选你用的那个）:"

msgid "The engine is the theme: remove any ZSH_THEME/theme setup first, otherwise they will stack."
msgstr "引擎即主题：先去掉原本的 ZSH_THEME/主题设置，否则会叠加。"

msgid "p11k configuration wizard has been aborted."
msgstr "p11k 配置向导已中止。"

msgid "Nothing was written."
msgstr "没有写入任何东西。"

# ---- 引擎本体 ----
msgid "recursive launch detected (p11k started inside a p11k session)"
msgstr "检测到递归加载（已在 p11k 会话内又启动了 p11k）"

msgid "make sure the bootstrap line in ~/.zshrc is guarded, e.g.:"
msgstr "请确认 ~/.zshrc 里的引导行带判断，例如："

msgid "cannot exec zsh -f: "
msgstr "exec zsh -f 失败: "

msgid "cannot exec a clean shell: "
msgstr "exec 干净 shell 失败: "

msgid "config error: "
msgstr "配置错误: "

msgid "every prompt_char state must be the same width (the prompt width is fixed at startup). Fix the config and start p11k again."
msgstr "prompt_char 各态提示符必须等宽（prompt 宽度在启动期固定）。请修改配置后重新启动 p11k。"

msgid "cannot read config, falling back to the built-in lean theme: "
msgstr "读取配置失败，回退内置 lean 主题: "

msgid "unknown preset, falling back to the built-in lean theme (expected lean/classic/rainbow/pure): "
msgstr "未知预设，回退内置 lean 主题（可选 lean/classic/rainbow/pure）: "

msgid "prompt_char states must all be the same width (the prompt width is fixed at startup)"
msgstr "prompt_char 各态提示符必须等宽（prompt 宽度在启动期固定）"


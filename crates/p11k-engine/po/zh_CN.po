"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# ---- 配置解析 ----
#: crates/p11k-engine/src/config.rs:427
msgid "KDL parse error: "
msgstr "KDL 解析失败: "

#: crates/p11k-engine/src/config.rs:1183
msgid "`state` needs a name (a positional string)"
msgstr "`state` 需要一个名字（位置字符串）"

#: crates/p11k-engine/src/config.rs:1201
msgid " needs text (a positional string)"
msgstr " 需要文本（位置字符串）"

#: crates/p11k-engine/src/config.rs:1256
msgid "unknown config key: "
msgstr "无法识别的配置键: "

#: crates/p11k-engine/src/main.rs:137 crates/p11k-engine/src/main.rs:158
msgid "cannot read config, falling back to the built-in lean theme: "
msgstr "读取配置失败，回退内置 lean 主题: "

#: crates/p11k-engine/src/main.rs:148
msgid ""
"unknown preset, falling back to the built-in lean theme (expected lean/"
"classic/rainbow/pure): "
msgstr "未知预设，回退内置 lean 主题（可选 lean/classic/rainbow/pure）: "

#: crates/p11k-engine/src/main.rs:178
msgid "not inside a p11k session (P11K_ENGINE_PID is unset)"
msgstr "当前不在 p11k 会话中（P11K_ENGINE_PID 未设置）"

#: crates/p11k-engine/src/main.rs:186
msgid ""
"this session has no theme file: it was started with --preset or the built-in "
"theme"
msgstr "本会话没有主题文件：启动时用的是 --preset 或内置主题"

#: crates/p11k-engine/src/main.rs:199
msgid "cannot signal the engine (the session may have exited)"
msgstr "无法向引擎发送信号（会话可能已退出）"

#: crates/p11k-engine/src/main.rs:222
msgid ""
"unknown shell in the config, falling back to $SHELL (expected zsh/bash/fish/"
"pwsh): "
msgstr "配置里的 shell 无法识别，回退到 $SHELL（可选 zsh/bash/fish/pwsh）: "

#: crates/p11k-engine/src/main.rs:542
msgid "usage: p11k [options]"
msgstr "用法: p11k [选项]"

#: crates/p11k-engine/src/main.rs:543
msgid "       p11k configure"
msgstr "       p11k configure"

#: crates/p11k-engine/src/main.rs:544
msgid "       p11k reload"
msgstr "       p11k reload"

#: crates/p11k-engine/src/main.rs:546
msgid "Options:"
msgstr "选项:"

#: crates/p11k-engine/src/main.rs:548
msgid ""
"  --shell <name>   inner shell to proxy: zsh, bash, fish or pwsh (default: "
"the `shell` config node, else $SHELL)"
msgstr ""
"  --shell <名字>   被代理的内部 shell：zsh、bash、fish 或 pwsh（缺省取配置里"
"的 `shell` 节点，无则用 $SHELL）"

#: crates/p11k-engine/src/main.rs:551
msgid ""
"  --config <path>  KDL theme file (default: ~/.config/p11k/p11k.kdl, else "
"the built-in lean theme)"
msgstr ""
"  --config <路径>  KDL 主题文件（缺省 ~/.config/p11k/p11k.kdl，无则用内置 "
"lean 主题）"

#: crates/p11k-engine/src/main.rs:553
msgid "  --preset <name>  built-in theme: lean, classic, rainbow or pure"
msgstr "  --preset <名字>  内置主题：lean、classic、rainbow 或 pure"

#: crates/p11k-engine/src/main.rs:554
msgid "  --version        print the version and exit"
msgstr "  --version        打印版本后退出"

#: crates/p11k-engine/src/main.rs:555
msgid "  --help           print this help and exit"
msgstr "  --help           打印本说明后退出"

#: crates/p11k-engine/src/main.rs:557
msgid "Commands:"
msgstr "子命令:"

#: crates/p11k-engine/src/main.rs:558
msgid "  configure        interactive theme wizard"
msgstr "  configure        交互式主题向导"

#: crates/p11k-engine/src/main.rs:559
msgid "  reload           re-read the theme file of the running session"
msgstr "  reload           重新读取当前会话的主题文件"

#: crates/p11k-engine/src/main.rs:561
msgid "Environment: P11K_ENGINE guards against recursion; P11K_USER_ZSHRC and"
msgstr "环境变量：P11K_ENGINE 用于防止递归加载；P11K_USER_ZSHRC 与"

#: crates/p11k-engine/src/main.rs:562
msgid "P11K_USER_PROFILE override the rc that gets sourced; P11K_LOCALEDIR"
msgstr "P11K_USER_PROFILE 用于覆盖所 source 的 rc；P11K_LOCALEDIR"

#: crates/p11k-engine/src/main.rs:563
msgid "overrides the translation directory. The engine exports P11K_CONFIG and"
msgstr "用于覆盖翻译目录。引擎会把 P11K_CONFIG 与"

#: crates/p11k-engine/src/main.rs:564
msgid "P11K_ENGINE_PID into the shell for `p11k reload`."
msgstr "P11K_ENGINE_PID 导出给 shell，供 `p11k reload` 使用。"

#: crates/p11k-engine/src/main.rs:566
msgid ""
"To use p11k as your theme, add one line to your shell rc — see README.md."
msgstr "若要将 p11k 用作主题，请在 shell rc 中加入一行，详见 README.zh.md"

# ---- 引擎本体 ----
#: crates/p11k-engine/src/main.rs:611
msgid "recursive launch detected (p11k started inside a p11k session)"
msgstr "检测到递归启动（在 p11k 会话内再次启动 p11k）"

#: crates/p11k-engine/src/main.rs:612
msgid "make sure the bootstrap line in ~/.zshrc is guarded, e.g.:"
msgstr "请确认 ~/.zshrc 中的引导行包含递归判断，例如："

#: crates/p11k-engine/src/main.rs:616
msgid "cannot exec zsh -f: "
msgstr "exec zsh -f 失败: "

#: crates/p11k-engine/src/main.rs:632
msgid "config error: "
msgstr "配置错误: "

#: crates/p11k-engine/src/main.rs:636
msgid ""
"every prompt_char state must be the same width (the prompt width is fixed at "
"startup). Fix the config and start p11k again."
msgstr ""
"prompt_char 各态提示符必须等宽（prompt 宽度在启动期固定）。请修改配置后重新启"
"动 p11k。"

#: crates/p11k-engine/src/main.rs:650
msgid "cannot exec a clean shell: "
msgstr "exec 干净 shell 失败: "

#: crates/p11k-engine/src/main.rs:769
msgid "the inner shell failed to start"
msgstr "内部 shell 启动失败"


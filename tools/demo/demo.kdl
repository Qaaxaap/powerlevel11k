// p11k demo theme: the "classic" preset look, written out so both the recording
// and the README can point at one file.
mode "nerdfont-complete"

layout {
    left {
        line { os_icon; dir; vcs }
    }
    right {
        line { status; command_execution_time; background_jobs; time }
    }
}

separators gap-foreground=240 sub-foreground=242 right-sub-foreground=242 {
    segment ""
    sub ""
    end ""
    right-start ""
    right-segment ""
    right-sub ""
    left-tail ""
    right-tail ""
    gap "·"
}

frame fg=238 {
    first-prefix "╭─"
    first-suffix "─╮"
    newline-prefix "├─"
    newline-suffix "─┤"
    last-prefix "╰─"
}

segments {
    os_icon fg=255 bg=234
    dir fg=31 bg=234 shorten-strategy="truncate_to_unique" shorten-dir-length=1 {
        state "ANCHOR" fg=39 bold=#true
        state "SHORTENED" fg=103
    }
    vcs bg=234 clean-foreground=76 modified-foreground=178 conflicted-foreground=196 untracked-foreground=39 meta-foreground=246 shorten-strategy="truncate_middle" shorten-length=12 shorten-min-length=32
    status bg=234 ok-foreground=70 error-foreground=160 verbose=#true
    command_execution_time fg=248 bg=234 threshold-seconds=3 precision=0
    background_jobs fg=37 bg=234 verbose=#false
    time fg=66 bg=234 time-format="24h"
    prompt_char fg=76 {
        state "ERROR" fg=196
    }
}
